{
  "version": 1,
  "sdk_version": "0.26.1",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://invdjkxkyytdpervudzw.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "kaghaz-o-baad",
      "version": "0.1.0",
      "title": "Kaghaz-o-Baad"
    },
    "tools": [
      {
        "name": "list_articles",
        "title": "List articles",
        "description": "List articles visible to the signed-in user, newest first. Optional text search and status filter.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "Free-text search across English and Persian titles."
            },
            "status": {
              "type": "string",
              "enum": [
                "draft",
                "published"
              ],
              "description": "Filter by article status."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "Max rows to return (default 20)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_article",
        "title": "Get article with slides",
        "description": "Fetch one article by slug, including its ordered slides (bilingual title and body).",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1,
              "description": "Article slug, e.g. 'my-article'."
            }
          },
          "required": [
            "slug"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_article_draft",
        "title": "Create article draft",
        "description": "Create a new draft article authored by the signed-in user. Drafts are not publicly visible.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1,
              "description": "URL slug, lowercase with hyphens."
            },
            "title_fa": {
              "type": "string",
              "minLength": 1,
              "description": "Persian title."
            },
            "title_en": {
              "type": "string",
              "minLength": 1,
              "description": "English title."
            },
            "summary_fa": {
              "type": "string",
              "description": "Short Persian summary."
            },
            "summary_en": {
              "type": "string",
              "description": "Short English summary."
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Tag list."
            },
            "categories": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Category list."
            }
          },
          "required": [
            "slug",
            "title_fa",
            "title_en"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_live_sessions",
        "title": "List live sessions",
        "description": "List live/scheduled sessions, newest first, with schedule and status.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "scheduled",
                "live",
                "ended",
                "cancelled"
              ],
              "description": "Filter by session status."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "Max rows to return (default 20)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "whoami",
        "title": "Who am I",
        "description": "Return the signed-in user's profile (name, phone, bio) and roles.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      }
    ]
  }
}
