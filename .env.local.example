# فقط برای Docker Compose توسعهٔ محلی؛ این فایل secret production نیست.
POSTGRES_DB=kaghazbaad_dev
POSTGRES_USER=kaghazbaad
POSTGRES_PASSWORD=local_dev_password_change_me
POSTGRES_PORT=5432
BACKEND_PORT=8080
AUTH_JWT_SECRET=local-only-change-this-secret-please-32-chars
CORS_ORIGIN=http://localhost:5173

# اختیاری؛ بدون این مقدار، endpointهای AI در حالت provider-not-configured باقی می‌مانند.
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5-mini
