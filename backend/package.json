{
  "name": "kaghazbaad-backend",
  "private": true,
  "version": "0.1.0",
  "description": "Independent backend for the Kaghaz-o-Baad platform",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:dry-run": "tsx src/db/migrate.ts --dry-run",
    "db:check": "tsx src/db/check.ts",
    "bootstrap:admin": "node dist/scripts/bootstrap-admin.js",
    "jobs:cleanup-ai-cache": "tsx src/jobs/cleanup-ai-cache.ts",
    "jobs:subscription-lifecycle": "tsx src/jobs/subscription-lifecycle.ts",
    "test:integration": "node ../tests/integration/api-smoke.mjs",
    "test:auth": "tsx --test tests/auth/*.test.ts",
    "test:casio": "tsx --test tests/casio-plus/*.test.ts",
    "test:k6": "k6 run ../tests/k6/kaghazbaad-api.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "jobs:mailbox-worker": "tsx src/jobs/mailbox-outbox-worker.ts",
    "jobs:casio-outbox-worker": "tsx src/jobs/casio-outbox-worker.ts",
    "health:liara-mail": "node ../scripts/check-liara-mail-health.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@fastify/cors": "^10.0.2",
    "fastify": "^5.2.1",
    "fastify-raw-body": "^6.0.1",
    "jose": "^6.0.10",
    "livekit-server-sdk": "^2.17.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.13.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "@types/nodemailer": "^6.4.24",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
}
