{
  "name": "kaghazbaad-backend",
  "private": true,
  "version": "0.1.0",
  "description": "Independent backend for the Kaghaz-o-Baad platform",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:dry-run": "tsx src/db/migrate.ts --dry-run",
    "db:check": "tsx src/db/check.ts",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "fastify": "^5.2.1",
    "jose": "^6.0.10",
    "pg": "^8.13.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
}
