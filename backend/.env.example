# Liara / runtime
NODE_ENV=production
HOST=0.0.0.0
PORT=8080

# Required core secrets
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=false
AUTH_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CORS_ORIGIN=https://<frontend-app-domain>

# AI usage gateway
AI_PROVIDER=openai
AI_API_KEY=replace-with-ai-provider-key
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5-mini
AI_TIMEOUT_MS=30000
AI_CACHE_ENABLED=true
AI_TITLE_CACHE_TTL_SECONDS=86400
AI_TITLE_PROMPT_VERSION=title-v1

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_IP_PER_MINUTE=120
RATE_LIMIT_USER_PER_MINUTE=60
RATE_LIMIT_AI_PER_MINUTE=10

# Billing / ZarinPal
ZARINPAL_MERCHANT_ID=replace-with-zarinpal-merchant-uuid
ZARINPAL_SANDBOX=true
PAYMENT_CALLBACK_BASE_URL=https://<backend-app-domain>
PAYMENT_PROVIDER_TIMEOUT_MS=30000

# LiveKit: required for live sessions
LIVEKIT_URL=https://<livekit-host>
LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-livekit-api-secret

# Liara Object Storage (S3-compatible)
S3_ENDPOINT=https://<object-storage-endpoint>
S3_REGION=us-east-1
S3_BUCKET=kaghazbaad-media-staging
S3_ACCESS_KEY_ID=replace-with-storage-access-key
S3_SECRET_ACCESS_KEY=replace-with-storage-secret-key

# SMS.ir Verify / OTP (server-side only)
SMSIR_API_KEY=replace-with-smsir-api-key
SMSIR_TEMPLATE_ID=replace-with-smsir-template-id
SMSIR_CODE_PARAMETER=CODE
SMSIR_TIMEOUT_MS=10000
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5

# Email verification (server-side only)
EMAIL_PROVIDER=resend
EMAIL_FROM=verified@kaghazobaad.ir
RESEND_API_KEY=replace-with-resend-api-key
EMAIL_VERIFICATION_TTL_SECONDS=1800

# Optional job tuning
CACHE_CLEANUP_BATCH_SIZE=100
SUBSCRIPTION_GRACE_DAYS=3
SUBSCRIPTION_JOB_BATCH_SIZE=100

# Liara Mail mailbox provisioning (keep API token in Liara secret manager)
LIARA_MAIL_API_BASE_URL=https://mail-service.iran.liara.ir
LIARA_MAIL_API_TOKEN=replace-in-liara-secret-manager
LIARA_MAIL_SERVER_ID=replace-with-24-char-mail-server-id
LIARA_MAIL_DOMAIN=kaghazobaad.ir
MAILBOX_PROVISIONING_ENABLED=false
MAILBOX_WORKER_ENABLED=false
MAILBOX_WORKER_POLL_MS=2000
MAILBOX_WORKER_BATCH_SIZE=10
MAILBOX_WORKER_CONCURRENCY=2
MAILBOX_MAX_ATTEMPTS=8
MAILBOX_BACKOFF_BASE_MS=2000
MAILBOX_BACKOFF_MAX_MS=900000
MAILBOX_LEASE_MS=120000
MAILBOX_HTTP_TIMEOUT_MS=15000
MAILBOX_RECONCILE_ENABLED=false
MAILBOX_HEALTH_PORT=8080
