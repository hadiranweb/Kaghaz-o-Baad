{
  "name": "kaghazbaad-installer",
  "version": "0.1.0",
  "private": true,
  "description": "Kaghaz-o-Baad deployment wizard for Windows",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "package:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "extract-zip": "^2.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  },
  "build": {
    "appId": "ir.kaghazbaad.installer",
    "productName": "نصب‌کنندهٔ کاغذ و باد",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "src/renderer/**/*", "package.json"],
    "win": { "target": "nsis", "artifactName": "KaghazBaad-Installer-${version}.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true }
  }
}
